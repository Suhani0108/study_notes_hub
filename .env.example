# Copy this file to .env and fill in real values. Never commit .env!
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY='your-secret-key-here'

# True for local development, False in production
DEBUG=True

# Comma-separated domains the site can be served from
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional. Leave unset to use the local SQLite file (db.sqlite3).
# In production this is your PostgreSQL connection string:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
